---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLang, useTranslations } from "../../i18n/utils";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import TrustBar from "../../components/sections/TrustBar.astro";
import BenefitsSection from "../../components/sections/BenefitsSection.astro";
import SolutionsSection from "../../components/sections/SolutionsSection.astro";
import CtaSection from "../../components/sections/CtaSection.astro";
import ContactSection from "../../components/sections/ContactSection.astro";
import MapSection from "../../components/sections/MapSection.astro";

const lang = getLang(Astro.url, import.meta.env.BASE_URL);
const t = useTranslations(lang);
---

<BaseLayout t={t} lang={lang}>
  <Navbar t={t} lang={lang} />

	<HeroSection t={t} lang={lang} />
	<TrustBar t={t} lang={lang} />
	<BenefitsSection t={t} lang={lang} />
	<SolutionsSection t={t} lang={lang} />
	<CtaSection t={t} lang={lang} />
	<ContactSection t={t} lang={lang} />
	<MapSection t={t} lang={lang} />

	<Footer t={t} lang={lang} />
</BaseLayout>