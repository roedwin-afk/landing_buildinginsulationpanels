---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLang, useTranslations } from "../../i18n/utils";

const lang = getLang(Astro.url, import.meta.env.BASE_URL);
const t = useTranslations(lang);
---

<BaseLayout t={t} lang={lang}>
  <h1 style="padding: 4rem; text-align: center;">🚧 En construcción</h1>
</BaseLayout>