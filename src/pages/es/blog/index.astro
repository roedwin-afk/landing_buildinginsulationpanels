---
export const prerender = false;

import BlogTimeline from '../../../components/blog/BlogTimeline.astro';
import { getLang, useTranslations } from "../../../i18n/utils";
import { createWPClient } from 'astro-blog-kit/utils';
import { resolveHero, resolveUI } from 'astro-blog-kit';
import config from '../../../../blog.config';
import BaseLayout from "../../../layouts/BaseLayout.astro";

const wp = createWPClient(config.wpUrl);

let posts: any[] = [];
let totalPages = 0;
let wpError = false;

try {
  ({ posts, totalPages } = await wp.getPosts({ perPage: config.postsPerPage ?? 5, page: 1 }));
} catch (err) {
  console.error('[blog] Error consultando WordPress:', err);
  wpError = true;
  Astro.response.status = 503;
}

const locale = 'es';

const bt = {
  blog: {
    tagline:     'Nuestro Blog',
    title_line1: 'Últimos',
    title_line2: 'Artículos',
    description: 'Bienvenido a nuestro blog.',
    btncta:      'Leer más',
    btn_prev:    'Anterior',
    btn_next:    'Siguiente',
  },
};

const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url, import.meta.env.BASE_URL);
const t = useTranslations(lang);
---

<BaseLayout t={t} lang={lang}>
  {wpError ? (
    <section style="max-width:var(--bk-container-max);margin-inline:auto;padding:6rem 1rem;min-height:60vh">
      <p>No pudimos cargar los artículos en este momento. Inténtalo de nuevo más tarde.</p>
    </section>
  ) : (
    <BlogTimeline
      posts={posts}
      currentPage={1}
      totalPages={totalPages}
      basePath={`${base}es/blog/page/`}
      blogBase={`${base}es/blog/`}
      dateLocale={locale}
      t={bt}
      locale={locale}
      layout={config.defaultLayout ?? 'magazine'}
    />
  )}
</BaseLayout>