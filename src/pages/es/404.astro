---
import { useTranslations, getLang } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url, base);
const t = useTranslations(lang);

const isEs = lang === "es";
---

<BaseLayout t={t} lang={lang}>
  <section class="not-found">
    <div class="not-found__inner">
      <div class="not-found__badge">{t.notFound.badge}</div>

      <h1 class="not-found__title">
        {t.notFound.title}
        <span class="not-found__highlight">{t.notFound.titleHighlight}</span>
      </h1>

      <p class="not-found__description">{t.notFound.description}</p>

      <a href={base} class="btn-primary">{t.notFound.cta}</a>
    </div>
  </section>

</BaseLayout>


<style>
  .not-found {
    min-height: 100vh;
    background-color: var(--color-black);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem;
    position: relative;
    overflow: hidden;
  }

  /* Decorative background number */
  .not-found__code {
    position: absolute;
    font-family: var(--font-heading);
    font-size: clamp(12rem, 35vw, 22rem);
    font-weight: 700;
    color: var(--color-white);
    opacity: 0.03;
    line-height: 1;
    user-select: none;
    pointer-events: none;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }

  .not-found__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 36rem;
  }

  .not-found__badge {
    display: inline-block;
    background-color: var(--color-yellow);
    color: var(--color-black);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 0.35rem 1rem;
  }

  .not-found__title {
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1;
    margin: 0;
  }

  .not-found__highlight {
    color: var(--color-yellow);
  }

  .not-found__description {
    color: var(--color-gray-400);
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Yellow accent bar at bottom */
  .not-found::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: var(--color-yellow);
  }
</style>