---
// src/pages/faq.astro
import { useTranslations, getLang } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollReveal from "../components/ui/ScrollReveal.astro";
import CtaSection from "../components/sections/CtaSection.astro";

const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url, base);
const t = useTranslations(lang);

type FaqItem = { question: string; answer: string };
const items = t.faqPage.items as unknown as FaqItem[];

// JSON-LD FAQPage schema — GEO / Google rich results
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer,
    },
  })),
};
---

<BaseLayout t={t} lang={lang}>
  <!-- JSON-LD inline — BaseLayout no expone slot="head" -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ── Hero ────────────────────────────────────────────────────────────── -->
  <section class="page-hero">
    <div class="page-hero__accent" aria-hidden="true"></div>
    <div class="page-hero__inner">
      <ScrollReveal variant="fade-up">
        <div class="page-hero__badge">{t.faqPage.hero.badge}</div>
        <h1 class="page-hero__title">
          {t.faqPage.hero.title}{" "}
          <span class="page-hero__highlight">{t.faqPage.hero.titleHighlight}</span>
        </h1>
        <p class="page-hero__description">{t.faqPage.hero.description}</p>
      </ScrollReveal>
    </div>
  </section>

  <!-- ── FAQ Accordion ────────────────────────────────────────────────────── -->
  <section class="faq-section">
    <div class="faq-section__inner">
      <div class="faq-list">
        {items.map((item, i) => (
          <ScrollReveal variant="fade-up" delay={(i % 3) as 0 | 1 | 2}>
            <div class="faq-item">
              <button class="faq-question" aria-expanded="false">
                <span>{item.question}</span>
                <svg
                  class="faq-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </button>
              <div class="faq-answer">
                <p>{item.answer}</p>
              </div>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <CtaSection t={t} lang={lang} />
</BaseLayout>

<!-- ── Accordion Script ──────────────────────────────────────────────────────
     FUERA de BaseLayout — patrón del proyecto.
     is:inline + astro:page-load para View Transitions.
     Guard por nodo (btn.dataset.faqReady) — evita listeners duplicados
     al navegar entre idiomas.
─────────────────────────────────────────────────────────────────────────── -->
<script is:inline>
  function initFaq() {
    const buttons = document.querySelectorAll(".faq-question");
    if (!buttons.length) return;

    buttons.forEach(function (btn) {
      if (btn.dataset.faqReady) return;
      btn.dataset.faqReady = "1";

      const item = btn.closest(".faq-item");
      const answer = item && item.querySelector(".faq-answer");
      if (answer) answer.style.height = "0px";
      btn.setAttribute("aria-expanded", "false");

      btn.addEventListener("click", function () {
        const isOpen = btn.getAttribute("aria-expanded") === "true";

        // Cerrar todos
        document.querySelectorAll(".faq-question").forEach(function (b) {
          const a = b.closest(".faq-item") &&
            b.closest(".faq-item").querySelector(".faq-answer");
          b.setAttribute("aria-expanded", "false");
          b.closest(".faq-item") &&
            b.closest(".faq-item").classList.remove("open");
          if (a) a.style.height = "0px";
        });

        // Abrir si estaba cerrado
        if (!isOpen) {
          const thisItem = btn.closest(".faq-item");
          const thisAnswer = thisItem && thisItem.querySelector(".faq-answer");
          btn.setAttribute("aria-expanded", "true");
          thisItem && thisItem.classList.add("open");
          if (thisAnswer) thisAnswer.style.height = thisAnswer.scrollHeight + "px";
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initFaq);
</script>

<style>
  /* ── Hero ────────────────────────────────────────────────────────────────── */
  .page-hero {
    background-color: var(--color-black);
    padding: 8rem 1rem 5rem;
    border-bottom: 4px solid var(--color-yellow);
    position: relative;
    overflow: hidden;
  }

  .page-hero__accent {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 30%;
    background-color: var(--color-yellow);
    transform: skewX(12deg) translateX(5rem);
    opacity: 0.08;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .page-hero__accent {
      opacity: 1;
    }
  }

  .page-hero__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    position: relative;
    z-index: 1;
    /* max-width: 48rem; */
  }

  .page-hero__badge {
    display: inline-block;
    background-color: var(--color-yellow);
    color: var(--color-black);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 0.35rem 1rem;
    margin-bottom: 1.5rem;
  }

  .page-hero__title {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .page-hero__highlight {
    color: var(--color-yellow);
  }

  .page-hero__description {
    color: var(--color-gray-300);
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 40rem;
  }

  /* ── FAQ Section ─────────────────────────────────────────────────────────── */
  .faq-section {
    padding: 6rem 1rem;
    background-color: var(--color-white);
  }

  .faq-section__inner {
    max-width: var(--container-max);
    margin-inline: auto;
  }

  /* ── Accordion ───────────────────────────────────────────────────────────── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 2px solid var(--color-gray-200);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-gray-200);
    transition: border-color 0.2s ease;
  }

  .faq-item.open {
    border-bottom-color: var(--color-yellow);
  }

  .faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-heading);
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-black);
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .faq-question:hover,
  .faq-item.open .faq-question {
    color: var(--color-gray-600);
  }

  .faq-icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-gray-400);
    transition: transform 0.3s ease, color 0.2s ease;
  }

  .faq-item.open .faq-icon {
    transform: rotate(180deg);
    color: var(--color-black);
  }

  /* Altura animada vía scrollHeight — nunca CSS max-height */
  .faq-answer {
    height: 0;
    overflow: hidden;
    transition: height 0.32s ease;
  }

  .faq-answer p {
    padding: 0 0 1.5rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-gray-600);
    max-width: 820px;
    border-top: 1px solid var(--color-gray-200);
    padding-top: 1.25rem;
  }
</style>