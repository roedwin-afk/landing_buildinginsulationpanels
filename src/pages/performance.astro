---
import { useTranslations, getLang } from "../i18n/utils";
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollReveal from "../components/ui/ScrollReveal.astro";
import CtaSection from "../components/sections/CtaSection.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import { Zap, Shield, Thermometer, Award } from "lucide-astro";


const base = import.meta.env.BASE_URL;
const lang = getLang(Astro.url, base);
const t = useTranslations(lang);

const benefits = [
  {
    icon: Zap,
    title: t.performancePage.benefits.fast.title,
    description: t.performancePage.benefits.fast.description,
    variant: "dark",
  },
  {
    icon: Shield,
    title: t.performancePage.benefits.durable.title,
    description: t.performancePage.benefits.durable.description,
    variant: "light",
  },
  {
    icon: Thermometer,
    title: t.performancePage.benefits.thermal.title,
    description: t.performancePage.benefits.thermal.description,
    variant: "accent",
  },
];

const stats = [
  t.performancePage.stats.items.faster,
  t.performancePage.stats.items.rValue,
  t.performancePage.stats.items.lifespan,
  t.performancePage.stats.items.fireRating,
];

const certifications = [
  { icon: Award, ...t.performancePage.certifications.items.usda },
  { icon: Award, ...t.performancePage.certifications.items.astm },
  { icon: Award, ...t.performancePage.certifications.items.iso },
  { icon: Award, ...t.performancePage.certifications.items.class_a },
];
---

<BaseLayout t={t} lang={lang}>

    <Navbar t={t} lang={lang} />

  <!-- Hero -->
  <section class="page-hero">
    <div class="page-hero__accent" aria-hidden="true"></div>
    <div class="page-hero__inner">
      <ScrollReveal variant="fade-up">
        <div class="page-hero__badge">{t.performancePage.hero.badge}</div>
        <h1 class="page-hero__title">
          {t.performancePage.hero.title}
          <span class="page-hero__highlight">{t.performancePage.hero.titleHighlight}</span>
        </h1>
        <p class="page-hero__description">{t.performancePage.hero.description}</p>
      </ScrollReveal>
    </div>
  </section>

  <!-- Benefits -->
  <section class="benefits">
    <div class="benefits__inner">
      {benefits.map(({ icon: Icon, title, description, variant }, i) => (
        <ScrollReveal variant="fade-up" delay={i as 0 | 1 | 2}>
          <div class={`benefit-card benefit-card--${variant}`}>
            <div class="benefit-card__icon"><Icon size={52} /></div>
            <h2 class="benefit-card__title">{title}</h2>
            <p class="benefit-card__description">{description}</p>
          </div>
        </ScrollReveal>
      ))}
    </div>
  </section>

  <!-- Stats -->
  <section class="stats">
    <div class="stats__inner">
      <ScrollReveal variant="fade-up">
        <h2 class="stats__title">
          {t.performancePage.stats.title}
          <span class="stats__highlight">{t.performancePage.stats.titleHighlight}</span>
        </h2>
      </ScrollReveal>
      <div class="stats__grid">
        {stats.map(({ value, label }, i) => (
          <ScrollReveal variant="fade-up" delay={i as 0 | 1 | 2}>
            <div class="stat-card">
              <span class="stat-card__value">{value}</span>
              <p class="stat-card__label">{label}</p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="certs">
    <div class="certs__inner">
      <ScrollReveal variant="fade-up">
        <h2 class="certs__title">
          {t.performancePage.certifications.title}
          <span class="certs__highlight">{t.performancePage.certifications.titleHighlight}</span>
        </h2>
        <p class="certs__subtitle">{t.performancePage.certifications.subtitle}</p>
      </ScrollReveal>

      <div class="certs__grid">
        {certifications.map(({ icon: Icon, title, description }, i) => (
          <ScrollReveal variant="fade-up" delay={(i % 3) as 0 | 1 | 2}>
            <div class="cert-card">
              <div class="cert-card__icon"><Icon size={32} /></div>
              <h3 class="cert-card__title">{title}</h3>
              <p class="cert-card__description">{description}</p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </section>

  <CtaSection t={t} lang={lang} />

  <Footer t={t} lang={lang} />

</BaseLayout>

<style>
  /* Hero */
  .page-hero {
    background-color: var(--color-black);
    padding: 6rem 1rem 5rem;
    border-bottom: 4px solid var(--color-yellow);
    position: relative;
    overflow: hidden;
  }

  .page-hero__accent {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 30%;
    background-color: var(--color-yellow);
    transform: skewX(12deg) translateX(5rem);
    opacity: 0.08;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .page-hero__accent {
      opacity: 1;
    }
  }

  .page-hero__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    position: relative;
    z-index: 1;
    max-width: 48rem;
  }

  .page-hero__badge {
    display: inline-block;
    background-color: var(--color-yellow);
    color: var(--color-black);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 0.35rem 1rem;
    margin-bottom: 1.5rem;
  }

  .page-hero__title {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .page-hero__highlight {
    color: var(--color-yellow);
  }

  .page-hero__description {
    color: var(--color-gray-300);
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 40rem;
  }

  /* Benefits */
  .benefits {
    padding: 6rem 1rem;
    background-color: var(--color-white);
  }

  .benefits__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .benefits__inner {
      flex-direction: row;
    }
  }

  .benefit-card {
    flex: 1;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 2px solid transparent;
    transition: transform 0.3s ease;
  }

  .benefit-card:hover {
    transform: translateY(-4px);
  }

  .benefit-card--dark {
    background-color: var(--color-black);
    color: var(--color-white);
    border-color: var(--color-black);
  }

  .benefit-card--dark .benefit-card__icon {
    color: var(--color-yellow);
  }

  .benefit-card--dark .benefit-card__description {
    color: var(--color-gray-400);
  }

  .benefit-card--light {
    background-color: var(--color-white);
    color: var(--color-black);
    border-color: var(--color-gray-200);
  }

  .benefit-card--light .benefit-card__description {
    color: var(--color-gray-600);
  }

  .benefit-card--accent {
    background-color: var(--color-yellow);
    color: var(--color-black);
    border-color: var(--color-yellow);
  }

  .benefit-card--accent .benefit-card__description {
    color: rgba(0, 0, 0, 0.7);
    font-weight: 500;
  }

  .benefit-card__icon {
    display: flex;
  }

  .benefit-card__title {
    font-size: 1.75rem;
    font-weight: 700;
  }

  .benefit-card__description {
    font-size: 0.95rem;
    line-height: 1.75;
  }

  /* Stats */
  .stats {
    background-color: var(--color-black);
    padding: 6rem 1rem;
  }

  .stats__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .stats__title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--color-white);
    line-height: 1;
  }

  .stats__highlight {
    color: var(--color-yellow);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-card {
    border-left: 4px solid var(--color-yellow);
    padding-left: 1.5rem;
  }

  .stat-card__value {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--color-yellow);
    line-height: 1;
  }

  .stat-card__label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gray-400);
    margin-top: 0.5rem;
  }

  /* Certifications */
  .certs {
    background-color: var(--color-gray-100);
    padding: 6rem 1rem;
    border-top: 1px solid var(--color-gray-200);
  }

  .certs__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .certs__title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .certs__highlight {
    background-color: var(--color-black);
    color: var(--color-yellow);
    padding: 0 0.4rem;
  }

  .certs__subtitle {
    color: var(--color-gray-600);
    font-size: 1rem;
  }

  .certs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .certs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .certs__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cert-card {
    background-color: var(--color-white);
    border: 2px solid var(--color-gray-200);
    border-top: 4px solid var(--color-yellow);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.3s ease;
  }

  .cert-card:hover {
    transform: translateY(-4px);
  }

  .cert-card__icon {
    color: var(--color-yellow);
    background-color: var(--color-black);
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cert-card__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-black);
  }

  .cert-card__description {
    font-size: 0.875rem;
    color: var(--color-gray-600);
    line-height: 1.6;
  }
</style>