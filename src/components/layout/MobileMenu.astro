---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";
import NavLinks from "../ui/NavLinks.astro";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;
const base = lang === "es" ? "/es" : "";
---

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <div class="mobile-menu__inner">
    <NavLinks t={t} lang={lang} variant="mobile" />
    <div class="mobile-menu__cta">
      <a href={`${base}/#contact`} class="btn-primary mobile-menu__btn">
        {t.nav.getQuote}
      </a>
    </div>
  </div>
</div>

<script>
  function initMobileMenu() {
    const btn = document.getElementById("hamburger-btn");
    const menu = document.getElementById("mobile-menu");

    if (!btn || !menu) return;

    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";

      btn.setAttribute("aria-expanded", String(!isOpen));
      menu.setAttribute("aria-hidden", String(isOpen));
      menu.classList.toggle("mobile-menu--open", !isOpen);
    });

    // Cerrar al hacer click en un link
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        btn.setAttribute("aria-expanded", "false");
        menu.setAttribute("aria-hidden", "true");
        menu.classList.remove("mobile-menu--open");
      });
    });
  }

  // Funciona con View Transitions
  document.addEventListener("astro:page-load", initMobileMenu);
</script>

<style>
  .mobile-menu {
    position: fixed;
    top: 5rem; /* altura del navbar */
    left: 0;
    width: 100%;
    height: calc(100vh - 5rem);
    background-color: var(--color-black);
    z-index: 99;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
  }

  .mobile-menu--open {
    transform: translateX(0);
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .mobile-menu__cta {
    padding: 1.5rem;
    margin-top: auto;
    border-top: 1px solid #2a2a2a;
  }

  .mobile-menu__btn {
    display: block;
    text-align: center;
    width: 100%;
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }
</style>