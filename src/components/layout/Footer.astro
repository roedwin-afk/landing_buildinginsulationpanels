---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";
import NavLinks from "../ui/NavLinks.astro";
import { Image } from "astro:assets";
import { Linkedin, Facebook, Instagram, Youtube } from "lucide-astro";

import logo from "../../assets/logo.svg";

interface Props {
    t: TranslationKeys;
    lang: Lang;
}

const { t, lang } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const socials = [
    { icon: Linkedin, label: "LinkedIn", href: "https://linkedin.com" },
    { icon: Facebook, label: "Facebook", href: "https://facebook.com" },
    { icon: Instagram, label: "Instagram", href: "https://instagram.com" },
    { icon: Youtube, label: "YouTube", href: "https://youtube.com" },
];
---

<footer class="footer">
    <div class="footer__inner">
        <!-- Logo -->
        <a href={`${base}/`} class="footer__logo">
            <!-- <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="footer__logo-icon"
                aria-hidden="true"
            >
                <path d="M2 20h20"></path><path d="M4 20V10l8-6 8 6v10"
                ></path><path d="M9 20v-5h6v5"></path>
            </svg>
            <span class="footer__logo-text">
                BUILDING<span class="footer__logo-highlight">INSULATION</span
                >PANELS
            </span> -->
            <Image
                src={logo}
                alt="Panel sándwich para techo industrial"
                width={200}
                height={50}
                class="navbar__logo-img"
                format="webp"
                quality={85}
                loading="eager"
            />
        </a>

        <!-- Social -->
        <div class="footer__socials">
            {
                socials.map(({ icon: Icon, label, href }) => (
                    <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={label}
                        class="footer__social-link"
                    >
                        <Icon size={18} />
                    </a>
                ))
            }
        </div>

        <!-- Rights -->
        <p class="footer__rights">{t.footer.rights}</p>
    </div>
</footer>

<style>
    .footer {
        background-color: var(--color-black);
        border-top: 4px solid var(--color-yellow);
        padding: 3rem 1rem;
    }

    .footer__inner {
        max-width: var(--container-max);
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        text-align: center;
    }

    @media (min-width: 768px) {
        .footer__inner {
            flex-direction: row;
            justify-content: space-between;
            text-align: left;
        }
    }

    /* Logo */
    .footer__logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-white);
        text-decoration: none;
        transition: opacity 0.2s ease;
    }

    .footer__logo:hover {
        opacity: 0.8;
    }

    .footer__logo-icon {
        color: var(--color-yellow);
        flex-shrink: 0;
    }

    .footer__logo-text {
        font-family: var(--font-heading);
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        text-transform: uppercase;
    }

    .footer__logo-highlight {
        color: var(--color-yellow);
    }

    .navbar__logo-img {
        display: block;
        height: 2.5rem;
        width: auto;
        filter: brightness(0) invert(1);
    }

    /* Socials */
    .footer__socials {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .footer__social-link {
        color: var(--color-white);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid var(--color-gray-600);
        transition: var(--transition);
    }

    .footer__social-link:hover {
        color: var(--color-yellow);
        border-color: var(--color-yellow);
    }

    /* Rights */
    .footer__rights {
        font-size: 0.8rem;
        color: var(--color-gray-500);
    }
</style>
