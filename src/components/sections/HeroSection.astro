---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";
import ScrollReveal from "../ui/ScrollReveal.astro";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const langPrefix = lang === "es" ? `${base}/es` : base;
---

<header class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <div class="hero__badge">{t.hero.badge}</div>
      <h1 class="hero__title">
        {t.hero.titleSpeed}
        <span class="hero__highlight">{t.hero.titleSpeedHighlight}</span>
        <br />
        {t.hero.titleStrength}
        <span class="hero__highlight">{t.hero.titleStrengthHighlight}</span>
      </h1>
      <p class="hero__description">{t.hero.description}</p>
      <ScrollReveal variant="fade-left" delay={1}>
      <div class="hero__actions">
        <a href={`${langPrefix}/#contact`} class="btn-primary">
          {t.hero.ctaPrimary}
        </a>
        <a href={`${langPrefix}/#solutions`} class="btn-outline">
          {t.hero.ctaSecondary}
        </a>
      </div>
      </ScrollReveal>
    </div>
  </div>
  <div class="hero__bar"></div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    background:
      linear-gradient(rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.75)),
      url("https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&q=80&w=2000")
        center / cover no-repeat;
    color: var(--color-white);
  }

  .hero__inner {
    width: 100%;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .hero__content {
    max-width: 48rem;
  }

  .hero__badge {
    display: inline-block;
    background-color: var(--color-yellow);
    color: var(--color-black);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.25rem 1rem;
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .hero__highlight {
    color: var(--color-yellow);
  }

  .hero__description {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: #d1d5db;
    max-width: 40rem;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__bar {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1rem;
    background-color: var(--color-yellow);
  }
</style>