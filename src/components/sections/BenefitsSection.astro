---
import type { TranslationKeys } from "../../i18n/en";
import { Zap, Shield, Thermometer } from "lucide-astro";
import ScrollReveal from "../ui/ScrollReveal.astro";

interface Props {
  t: TranslationKeys;
  lang: string;
}

const { t } = Astro.props;

const benefits = [
  {
    icon: Zap,
    title: t.benefits.fast.title,
    description: t.benefits.fast.description,
    variant: "dark",
  },
  {
    icon: Shield,
    title: t.benefits.durable.title,
    description: t.benefits.durable.description,
    variant: "light",
  },
  {
    icon: Thermometer,
    title: t.benefits.thermal.title,
    description: t.benefits.thermal.description,
    variant: "accent",
  },
] as const;

const variants = ['left', 'up', 'right'] as const;
const delays = [1, 2, 1] as const;
---

<section id="benefits" class="benefits">
  <div class="benefits__grid">
    {
      benefits.map(({ icon: Icon, title, description, variant },i) => (
        <ScrollReveal variant={`fade-${variants[i]}`} delay={delays[i]}>
        <div class={`benefits__card benefits__card--${variant}`}>
          <div class="benefits__icon">
            <Icon size={48} />
          </div>
          <h3 class="benefits__title">{title}</h3>
          <p class="benefits__description">{description}</p>
        </div>
        </ScrollReveal>
      ))
    }
  </div>
</section>

<style>
  .benefits {
    padding: 6rem 1rem;
  }

  .benefits__grid {
    max-width: var(--container-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    border: 4px solid var(--color-black);
  }

  .benefits__card {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  /* Dark card */
  .benefits__card--dark {
    background-color: var(--color-black);
    color: var(--color-white);
  }

  .benefits__card--dark .benefits__icon {
    color: var(--color-yellow);
  }

  .benefits__card--dark .benefits__description {
    color: var(--color-gray-400);
  }

  /* Light card */
  .benefits__card--light {
    background-color: var(--color-white);
    color: var(--color-black);
    border-top: 4px solid var(--color-black);
    border-bottom: 4px solid var(--color-black);
  }

  .benefits__card--light .benefits__icon {
    color: var(--color-black);
  }

  .benefits__card--light .benefits__description {
    color: var(--color-gray-600);
  }

  /* Accent card */
  .benefits__card--accent {
    background-color: var(--color-yellow);
    color: var(--color-black);
  }

  .benefits__card--accent .benefits__icon {
    color: var(--color-black);
  }

  .benefits__card--accent .benefits__description {
    color: rgba(0, 0, 0, 0.75);
    font-weight: 500;
  }

  .benefits__icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .benefits__title {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
  }

  .benefits__description {
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
    max-width: 28ch;
  }

  @media (min-width: 768px) {
    .benefits__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .benefits__card--light {
      border-top: none;
      border-bottom: none;
      border-left: 4px solid var(--color-black);
      border-right: 4px solid var(--color-black);
    }
  }
</style>