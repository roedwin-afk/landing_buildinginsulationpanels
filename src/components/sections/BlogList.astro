---
interface Props {
  posts: any[];
  currentPage: number;
  totalPages: number;
  basePath: string;
  t: any;
  locale: string;
}

const { posts, currentPage, totalPages, basePath, t, locale } = Astro.props;

const paginationLinks = Array.from({ length: totalPages }, (_, i) => i + 1);
const dateLocale = locale === "es" ? "es-US" : "en-US";
const base = import.meta.env.BASE_URL;
const blogBase = locale === "es" ? `${base}es/blog/` : `${base}blog/`;
const pageBase = basePath;

const featured = posts[0];
const rest = posts.slice(1);
---

<section class="blog">
  <div class="blog__container">

    <div class="blog__header">
      <div class="blog__badge">{t.blog.tagline}</div>
      <h1 class="blog__title">
        {t.blog.title_line1}
        <span class="blog__title-highlight">{t.blog.title_line2}</span>
      </h1>
      <p class="blog__desc">{t.blog.description}</p>
    </div>

    <div class="blog__grid">

      <!-- Featured post — left large column -->
      {featured && (() => {
        const imgUrl = featured._embedded?.["wp:featuredmedia"]?.[0]?.source_url;
        return (
          <article class="blog-card blog-card--featured">
            <a href={`${blogBase}${featured.slug}/`} class="blog-card__link">
              <div class="blog-card__thumb">
                {imgUrl ? (
                  <img src={imgUrl} alt={featured.title.rendered} class="blog-card__img" loading="lazy" />
                ) : (
                  <div class="blog-card__placeholder">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="M21 15l-5-5L5 21"/>
                    </svg>
                  </div>
                )}
                <div class="blog-card__overlay" aria-hidden="true"></div>
                <div class="blog-card__featured-badge">Featured</div>
              </div>
              <div class="blog-card__body">
                <time class="blog-card__date">
                  {new Date(featured.date).toLocaleDateString(dateLocale, {
                    year: "numeric", month: "long", day: "numeric",
                  })}
                </time>
                <h2 class="blog-card__title" set:html={featured.title.rendered} />
                <div class="blog-card__excerpt" set:html={featured.excerpt.rendered} />
                <span class="blog-card__cta">{t.blog.btncta} →</span>
              </div>
            </a>
          </article>
        );
      })()}

      <!-- Right column grid -->
      <div class="blog__right">
        {rest.map((post: any) => {
          const imgUrl = post._embedded?.["wp:featuredmedia"]?.[0]?.source_url;
          return (
            <article class="blog-card blog-card--small">
              <a href={`${blogBase}${post.slug}/`} class="blog-card__link blog-card__link--horizontal">

                <div class="blog-card__thumb blog-card__thumb--small">
                  {imgUrl ? (
                    <img src={imgUrl} alt={post.title.rendered} class="blog-card__img" loading="lazy" />
                  ) : (
                    <div class="blog-card__placeholder">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <path d="M21 15l-5-5L5 21"/>
                      </svg>
                    </div>
                  )}
                  <div class="blog-card__overlay" aria-hidden="true"></div>
                </div>

                <div class="blog-card__body blog-card__body--small">
                  <time class="blog-card__date">
                    {new Date(post.date).toLocaleDateString(dateLocale, {
                      year: "numeric", month: "long", day: "numeric",
                    })}
                  </time>
                  <h2 class="blog-card__title blog-card__title--small" set:html={post.title.rendered} />
                  <span class="blog-card__cta">{t.blog.btncta} →</span>
                </div>

              </a>
            </article>
          );
        })}
      </div>

    </div>

    {totalPages > 1 && (
      <nav class="pagination" aria-label="Blog pagination">
        {currentPage > 1 && (
          
           <a href={currentPage === 2 ? blogBase : `${pageBase}${currentPage - 1}/`}
            class="pagination__btn"
          >
            ← {t.blog.btn_prev}
          </a>
        )}
        <div class="pagination__pages">
          {paginationLinks.map((pageNum) => (
            
            <a  href={pageNum === 1 ? blogBase : `${pageBase}${pageNum}/`}
              class={`pagination__page ${pageNum === currentPage ? "pagination__page--active" : ""}`}
              aria-current={pageNum === currentPage ? "page" : undefined}
            >
              {pageNum}
            </a>
          ))}
        </div>
        {currentPage < totalPages && (
          <a href={`${pageBase}${currentPage + 1}/`} class="pagination__btn">
            {t.blog.btn_next} →
          </a>
        )}
      </nav>
    )}

  </div>
</section>

<style>
  .blog {
    background-color: var(--color-white);
    padding: 6rem 1rem;
    min-height: 100vh;
  }

  .blog__container {
    max-width: var(--container-max);
    margin-inline: auto;
  }

  /* Header */
  .blog__header {
    margin-bottom: 4rem;
    max-width: 48rem;
  }

  .blog__badge {
    display: inline-block;
    background-color: var(--color-yellow);
    color: var(--color-black);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 0.35rem 1rem;
    margin-bottom: 1.5rem;
  }

  .blog__title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    color: var(--color-black);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .blog__title-highlight {
    background-color: var(--color-black);
    color: var(--color-yellow);
    padding: 0 0.3rem;
  }

  .blog__desc {
    color: var(--color-gray-600);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  /* Layout grid */
  .blog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 1024px) {
    .blog__grid {
      grid-template-columns: 1.2fr 1fr;
      align-items: start;
    }
  }

  /* Right column */
  .blog__right {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Cards base */
  .blog-card {
    border: 2px solid var(--color-gray-200);
    background-color: var(--color-white);
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-yellow);
    border-bottom-width: 4px;
  }

  .blog-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* Horizontal layout for small cards */
  .blog-card__link--horizontal {
    flex-direction: row;
  }

  /* Thumb */
  .blog-card__thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-gray-100);
    overflow: hidden;
    flex-shrink: 0;
  }

  .blog-card__thumb--small {
    width: 140px;
    aspect-ratio: auto;
    min-height: 100%;
  }

  @media (max-width: 480px) {
    .blog-card__thumb--small {
      width: 100px;
    }
  }

  .blog-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-card__img {
    transform: scale(1.05);
  }

  .blog-card__placeholder {
    width: 100%;
    height: 100%;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray-300);
    background-color: var(--color-gray-100);
  }

  .blog-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(26,26,26,0.45) 100%);
    pointer-events: none;
  }

  .blog-card__featured-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: var(--color-yellow);
    color: var(--color-black);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.25rem 0.75rem;
  }

  /* Body */
  .blog-card__body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .blog-card__body--small {
    padding: 1rem 1.25rem;
    gap: 0.4rem;
  }

  .blog-card__date {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gray-400);
  }

  .blog-card__title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-black);
    line-height: 1.05;
    text-transform: uppercase;
    margin: 0;
  }

  .blog-card__title--small {
    font-size: 1rem;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__excerpt {
    font-size: 0.9rem;
    color: var(--color-gray-600);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .blog-card__excerpt :global(p) {
    margin: 0;
  }

  .blog-card__cta {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-black);
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .blog-card--small .blog-card__cta {
    padding-top: 0.25rem;
    font-size: 0.8rem;
  }

  .blog-card:hover .blog-card__cta {
    transform: translateX(4px);
  }

  /* Pagination */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 3rem;
    border-top: 2px solid var(--color-gray-200);
  }

  .pagination__btn {
    padding: 0.6rem 1.25rem;
    background-color: var(--color-black);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: var(--transition);
  }

  .pagination__btn:hover {
    background-color: var(--color-yellow);
    color: var(--color-black);
  }

  .pagination__pages {
    display: flex;
    gap: 0.4rem;
  }

  .pagination__page {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-gray-600);
    border: 2px solid var(--color-gray-200);
    text-decoration: none;
    transition: var(--transition);
  }

  .pagination__page:hover {
    border-color: var(--color-black);
    color: var(--color-black);
  }

  .pagination__page--active {
    background-color: var(--color-yellow);
    border-color: var(--color-yellow);
    color: var(--color-black);
  }
</style>