---
import type { TranslationKeys } from "../../i18n/en";
import ScrollReveal from "../ui/ScrollReveal.astro";

interface Props {
    t: TranslationKeys;
    lang: string;
}

const { t } = Astro.props;

const brands = ["GLOBALCON", "STEELCORE", "INDUS-X", "ARCHI-TECH"];
---

<section class="trust-bar">
    <ScrollReveal variant="fade-up" delay={1}>
        <div class="trust-bar__inner">
            <p class="trust-bar__label">{t.trust.label}</p>
            <ul class="trust-bar__brands" aria-label="Trusted companies">
                {
                    brands.map((brand) => (
                        <li class="trust-bar__brand">{brand}</li>
                    ))
                }
            </ul>
        </div>
    </ScrollReveal>
</section>

<style>
    .trust-bar {
        background-color: var(--color-gray-100);
        border-bottom: 1px solid var(--color-gray-200);
        padding: 2rem 1rem;
    }

    .trust-bar__inner {
        max-width: var(--container-max);
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        text-align: center;
    }

    .trust-bar__label {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--color-gray-500);
    }

    .trust-bar__brands {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 1.5rem 2.5rem;
    }

    .trust-bar__brand {
        font-size: 1.25rem;
        font-weight: 900;
        font-style: italic;
        color: var(--color-black);
        opacity: 0.35;
        filter: grayscale(1);
        letter-spacing: -0.02em;
        user-select: none;
        transition: opacity 0.3s ease;
    }

    .trust-bar__brand:hover {
        opacity: 0.6;
    }

    @media (min-width: 768px) {
        .trust-bar__brand {
            font-size: 1.5rem;
        }
    }
</style>
