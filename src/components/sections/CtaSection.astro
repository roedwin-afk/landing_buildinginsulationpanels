---
import type { TranslationKeys } from "../../i18n/en";
import ScrollReveal from "../ui/ScrollReveal.astro";

interface Props {
    t: TranslationKeys;
    lang: string;
}

const { t } = Astro.props;
---

<section id="specs" class="cta">
    <div class="cta__accent" aria-hidden="true"></div>

    <div class="cta__inner">
        <ScrollReveal variant="fade-big-right" delay={2}>
            <h2 class="cta__title">
                {t.cta.title}
                <span class="cta__title-highlight">{t.cta.titleHighlight}</span>
            </h2>

            <div class="cta__stats">
                <div class="cta__stat">
                    <span class="cta__stat-value">40%</span>
                    <p class="cta__stat-label">{t.cta.statFaster}</p>
                </div>
                <div class="cta__stat">
                    <span class="cta__stat-value">R-30+</span>
                    <p class="cta__stat-label">{t.cta.statEfficiency}</p>
                </div>
            </div>

            <p class="cta__description">{t.cta.description}</p>

            <a href="#contact" class="btn-primary">{t.cta.button}</a>
        </ScrollReveal>
    </div>

    <style>
        .cta {
            background-color: var(--color-black);
            color: var(--color-white);
            padding: 6rem 12rem;
            position: relative;
            overflow: hidden;
        }

        /* Diagonal yellow accent — right side */
        .cta__accent {
            position: absolute;
            top: 0;
            right: 0;
            height: 100%;
            width: 33%;
            background-color: var(--color-yellow);
            transform: skewX(12deg) translateX(5rem);
            opacity: 0.12;
            pointer-events: none;
        }

        @media (min-width: 768px) {
            .cta__accent {
                opacity: 1;
            }
        }

        .cta__inner {
            max-width: var(--container-max);
            margin-inline: auto;
            max-width: 40rem;
            margin-inline-start: auto;
            margin-inline-end: auto;
            position: relative;
            z-index: 1;
        }

        @media (min-width: 768px) {
            .cta__inner {
                margin-inline-start: 0;
                max-width: 38rem;
            }
        }

        .cta__title {
            font-size: 3rem;
            font-weight: 700;
            line-height: 1.05;
            margin-bottom: 2rem;
        }

        @media (min-width: 768px) {
            .cta__title {
                font-size: 3.5rem;
            }
        }

        .cta__title-highlight {
            color: var(--color-yellow);
        }

        /* Stats */
        .cta__stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            margin-bottom: 2.5rem;
        }

        .cta__stat-value {
            display: block;
            font-family: var(--font-heading);
            font-size: 2.75rem;
            font-weight: 700;
            color: var(--color-yellow);
            line-height: 1;
        }

        .cta__stat-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--color-gray-400);
            margin-top: 0.5rem;
        }

        .cta__description {
            color: var(--color-gray-300);
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 2rem;
        }
    </style>
</section>
