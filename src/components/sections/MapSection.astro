---
import type { TranslationKeys } from "../../i18n/en";
import type { Lang } from "../../i18n/utils";
import { MapPin } from "lucide-astro";
import ScrollReveal from "../ui/ScrollReveal.astro";

interface Props {
  t: TranslationKeys;
  lang: Lang;
}

const { t } = Astro.props;

const LAT = 19.4326;
const LNG = -99.1946;
---

<section class="map-section">
  <div class="map-section__inner">

    <ScrollReveal variant="fade-right">
    <!-- Left: info -->
    <div class="map-section__info">
      <div class="map-section__badge">
        <MapPin size={16} />
        <span>Headquarters</span>
      </div>

      <h2 class="map-section__title">
        Find Us <span class="map-section__title-highlight">Here</span>
      </h2>

      <p class="map-section__address">{t.contact.address.value}</p>

      <div class="map-section__contact">
        <div class="map-section__contact-item">
          <span class="map-section__contact-label">{t.contact.phone.label}</span>
          <a href={`tel:${t.contact.phone.value}`} class="map-section__contact-value">
            {t.contact.phone.value}
          </a>
        </div>
        <div class="map-section__contact-item">
          <span class="map-section__contact-label">{t.contact.email.label}</span>
          <a href={`mailto:${t.contact.email.value}`} class="map-section__contact-value">
            {t.contact.email.value}
          </a>
        </div>
      </div>

      <a href="#contact" class="btn-primary map-section__cta">
        Get a Quote →
      </a>
    </div>
    </ScrollReveal>

    <ScrollReveal variant="fade-left">
    <!-- Right: map -->
    <div class="map-section__map-wrapper">
      <div
        id="site-map"
        class="map-section__canvas"
        aria-label="Office location map"
        data-lat={LAT}
        data-lng={LNG}
      >
      </div>
    </div>
    </ScrollReveal>

  </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script>

<script is:inline>
  function initSiteMap() {
    const container = document.getElementById("site-map");
    if (!container || !window.L) return;
    if (container._leaflet_id) return;

    const lat = parseFloat(container.dataset.lat);
    const lng = parseFloat(container.dataset.lng);

    const icon = window.L.icon({
      iconUrl: "https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-yellow.png",
      shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -34],
      shadowSize: [41, 41],
    });

    const map = window.L.map("site-map").setView([lat, lng], 16);

    window.L.tileLayer(
      "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
      {
        attribution: '&copy; <a href="https://carto.com/">CARTO</a>',
        subdomains: "abcd",
        maxZoom: 19,
      }
    ).addTo(map);

    window.L.marker([lat, lng], { icon })
      .addTo(map)
      .bindPopup("Av. Pdte. Masaryk 61-901, Polanco V Secc, 11560, CDMX, México.")
      .openPopup();

    setTimeout(() => map.invalidateSize(), 200);
  }

  function waitForLeaflet() {
    if (window.L) {
      initSiteMap();
    } else {
      setTimeout(waitForLeaflet, 100);
    }
  }

  document.addEventListener("astro:page-load", waitForLeaflet);
</script>

<style>
  .map-section {
    background-color: var(--color-black);
    padding: 6rem 1rem;
  }

  .map-section__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .map-section__inner {
      grid-template-columns: 1fr 1.4fr;
      gap: 4rem;
      align-items: center;
    }
  }

  /* Left */
  .map-section__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--color-yellow);
    color: var(--color-black);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.35rem 0.75rem;
    margin-bottom: 1.5rem;
  }

  .map-section__title {
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-white);
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .map-section__title {
      font-size: 3.5rem;
    }
  }

  .map-section__title-highlight {
    color: var(--color-yellow);
  }

  .map-section__address {
    color: var(--color-gray-400);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-yellow);
  }

  .map-section__contact {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .map-section__contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .map-section__contact-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray-500);
  }

  .map-section__contact-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-white);
    transition: color 0.2s ease;
  }

  .map-section__contact-value:hover {
    color: var(--color-yellow);
  }

  .map-section__cta {
    display: inline-block;
  }

  /* Right: map */
  .map-section__map-wrapper {
    border: 4px solid var(--color-yellow);
    overflow: hidden;
  }

  .map-section__canvas {
    width: 100%;
    height: 350px;
  }

  @media (min-width: 1024px) {
    .map-section__canvas {
      height: 460px;
    }
  }

  /* Leaflet overrides */
  :global(.leaflet-popup-content-wrapper) {
    background: #1a1a1a !important;
    border: 1px solid #ffd700;
    border-radius: 0 !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
  }

  :global(.leaflet-popup-content) {
    color: #ffd700 !important;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 10px 14px;
  }

  :global(.leaflet-popup-tip) {
    background: #1a1a1a !important;
  }

  :global(.leaflet-popup-close-button) {
    color: #ffd700 !important;
  }

  :global(.leaflet-control-zoom a) {
    background: #1a1a1a !important;
    color: #ffd700 !important;
    border-color: #ffd700 !important;
    border-radius: 0 !important;
  }

  :global(.leaflet-control-zoom a:hover) {
    background: #ffd700 !important;
    color: #1a1a1a !important;
  }

  :global(.leaflet-control-attribution) {
    background: rgba(26, 26, 26, 0.85) !important;
    color: #6b7280 !important;
    font-size: 9px;
  }

  :global(.leaflet-control-attribution a) {
    color: #ffd700 !important;
  }
</style>